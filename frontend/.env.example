# Frontend configuration for Next.js.
#
#   cp .env.example .env.local
#
# Never put a secret in this file. The Supabase service-role key, the JWT
# secret, database passwords and access tokens belong only on the server
# (the root .env), never in the frontend.

# --- Browser-safe (embedded in the JavaScript sent to users) ---------------
# From the Supabase dashboard: Project Settings → API. Use the *publishable*
# key (sb_publishable_...), never the secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side only (not secret; read by the Next.js server) -------------
# Public origin used in confirmation-email links. Must be covered by the
# Supabase project's allowed redirect URLs (http://localhost:3000/**).
SITE_URL=http://localhost:3000
# FastAPI backend used by the dashboard. Change the port if 8000 is taken.
API_BASE_URL=http://127.0.0.1:8000
