# BROWSER-SAFE configuration for the Next.js frontend.
#
#   cp .env.example .env.local
#
# Every NEXT_PUBLIC_ value is embedded in the JavaScript sent to users'
# browsers, so it is public by definition. Never put a secret here. In
# particular, the Supabase service-role key and JWT secret belong only in
# the server-side root .env.
#
# Unused in Milestone 1; declared for Supabase Auth in Milestone 2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
