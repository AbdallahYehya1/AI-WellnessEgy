# Frontend configuration for Next.js.
#
#   cp .env.example .env.local
#
# Never put a real value for a secret in this file (it is committed). The
# Supabase service-role key, the JWT secret, database passwords and access
# tokens belong only on the backend (the root .env), never in the frontend.
# The one Next.js-server secret below goes in .env.local only.

# --- Browser-safe (embedded in the JavaScript sent to users) ---------------
# From the Supabase dashboard: Project Settings → API. Use the *publishable*
# key (sb_publishable_...), never the secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side only (not secret; read by the Next.js server) -------------
# Public origin used in confirmation-email links. Must be covered by the
# Supabase project's allowed redirect URLs (http://localhost:3000/**).
SITE_URL=http://localhost:3000
# FastAPI backend used by the dashboard. Change the port if 8000 is taken.
API_BASE_URL=http://127.0.0.1:8000

# --- Server-side SECRET (Next.js server only; never NEXT_PUBLIC_) -----------
# Signs the short-lived password-reset marker (lib/auth/recovery.ts). At least
# 32 random bytes, base64url. Without it, password reset is unavailable (fails
# closed). Generate a fresh value per environment and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates any reset links in progress.
RECOVERY_MARKER_SECRET=
