# SERVER-ONLY configuration for the backend and Docker Compose.
#
#   cp .env.example .env            # used by `docker compose`
#   cp .env.example backend/.env    # used when running the backend directly
#
# Never commit a real .env file (it is git-ignored).
# Browser-safe variables live separately in frontend/.env.example. The
# frontend never reads this file, and no value here may ever be given a
# NEXT_PUBLIC_ prefix.
#
# Milestone 1 needs none of these values: every setting has a safe default.

# --- General --------------------------------------------------------------
# development | test | staging | production  (API docs are off in production)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Host port Docker Compose publishes the API on (container port is 8000)
API_PORT=8000

# --- Secrets (declared for later milestones; unused in Milestone 1) --------
# Masked in logs and serialisation. Never expose to the frontend.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
