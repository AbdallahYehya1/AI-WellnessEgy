# SERVER-ONLY configuration for the backend and Docker Compose.
#
#   cp .env.example .env            # used by `docker compose`
#   cp .env.example backend/.env    # used when running the backend directly
#
# Never commit a real .env file (it is git-ignored).
# Browser-safe variables live separately in frontend/.env.example. The
# frontend never reads this file, and no value here may ever be given a
# NEXT_PUBLIC_ prefix.
#
# Every setting has a safe default. Without SUPABASE_URL the API still
# starts, but authenticated endpoints such as /me answer 503 (fail closed).

# --- General --------------------------------------------------------------
# development | test | staging | production  (API docs are off in production)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Host ports Docker Compose publishes the API and local Postgres on
API_PORT=8000
DB_PORT=5432
# Password for the local Compose Postgres only (not used for Supabase)
LOCAL_DB_PASSWORD=local-dev-only

# --- Supabase Auth (not secret) -------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co. Access tokens are
# verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Secrets --------------------------------------------------------------
# Masked in logs and serialisation. Never expose to the frontend.
# Only for projects still on the legacy shared-secret (HS256) JWT signing
# key. Leave empty for projects using asymmetric signing keys (the default).
SUPABASE_JWT_SECRET=
# Postgres connection for the app's own tables (schema `app`). Used by the API
# and by `alembic upgrade head`. For the local Compose database:
#   postgresql://wellness:local-dev-only@127.0.0.1:5432/wellness
# For Supabase, use the project's direct or session-pooler connection string.
# Without it, profile and consent endpoints answer 503 (fail closed).
DATABASE_URL=
# Declared for later milestones; unused.
SUPABASE_SERVICE_ROLE_KEY=
